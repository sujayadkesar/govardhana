---
import Base from '../layouts/Base.astro';
import CauseCard from '../components/CauseCard.astro';
import { site } from '../data/site';
import { causes, causeGroups, byGroup } from '../data/causes';
import { formatINR } from '../lib/upi';

const featured = ['adopt-a-cow', 'go-kanike', 'one-day-expense'].map(
  (s) => causes.find((c) => c.slug === s)!
);
---

<Base
  title={site.name}
  description="A goshala at Karadolli, Yellapur in Uttara Kannada, under the Sonda Swarnavalli Mahasamsthanam. Adopt a cow, feed the herd, or mark an occasion with a Go Pooja."
  image="/images/vikas-makwana-UETquu-C_98-unsplash.webp"
>
  <!-- ============ hero ============ -->
  <section class="hero">
    <div class="hero__media">
      <img
        src="/images/vikas-makwana-UETquu-C_98-unsplash.webp"
        alt="Cows at the goshala in Karadolli"
        width="1600"
        height="1067"
        fetchpriority="high"
      />
    </div>

    <div class="wrap hero__body">
      <p class="hero__lineage">{site.lineage}</p>
      <h1 class="hero__title">{site.name}</h1>
      <p class="hero__place">
        {site.address.line} · {site.address.district} · Reg. {site.registration}
      </p>

      <div class="hero__verse">
        <p class="shloka">गवां यः पूजयेत्काले मुखे तस्य वसुन्धरा।</p>
        <p class="shloka-gloss">
          To one who honours the cow in her time, the earth itself turns
          toward them.
        </p>
      </div>

      <div class="hero__actions">
        <a href="/goseva" class="btn btn--accent">Ways to give</a>
        <a href="/about" class="btn btn--ghost">See the goshala</a>
      </div>
    </div>
  </section>

  <!-- ============ what it costs ============ -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What your giving covers</p>
      <h2 class="ledger__head">
        Everything here has a real cost. These are ours.
      </h2>

      <div class="ledger">
        {featured.map((c) => (
          <a class="ledger__row" href={`/goseva/${c.slug}`}>
            <span class="ledger__amt num">
              {c.amount ? formatINR(c.amount) : 'Any amount'}
            </span>
            <span class="ledger__what">
              <strong>{c.title}</strong>
              <span>{c.blurb}</span>
            </span>
            <span class="ledger__go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <p class="ledger__note">
        Donations are eligible for exemption under section 80G. Ask for a
        receipt when you give and we will send the certificate once the
        donation is verified.
      </p>
    </div>
  </section>

  <!-- ============ ways to give ============ -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Go Seva</p>
      <h2>Choose how you want to help</h2>
      <p class="lede ways__lede">
        Adopt an animal for a year, cover a day of the goshala’s running, or
        mark a birthday or anniversary with a Go Pooja performed in your name.
      </p>

      {causeGroups.map((g) => (
        <div class="ways__group">
          <div class="ways__ghead">
            <h3>{g.title}</h3>
            <p>{g.blurb}</p>
          </div>
          <div class="ways__grid">
            {byGroup(g.id).map((c) => <CauseCard cause={c} />)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ verse ============ -->
  <section class="verse">
    <div class="wrap wrap--tight verse__in">
      <p class="shloka">
        गोस्पर्शनविहीनस्य गोदोहनमजानतः ।<br />
        गोपोषणविहीनस्य प्राहुर्जन्म निरर्थकम् ॥
      </p>
      <p class="shloka-gloss">
        They call it a wasted birth — to have never touched a cow, never known
        her milking, never kept one fed. — Garuda Purana
      </p>
    </div>
  </section>

  <!-- ============ close ============ -->
  <section class="section closing">
    <div class="wrap wrap--tight">
      <h2>Can’t keep a cow? Keep one fed.</h2>
      <p class="lede">
        Every rupee goes to feed, shelter, medicine and the people who do the
        work. Give once, or mark a date each year.
      </p>
      <a href="/goseva" class="btn btn--accent">Ways to give</a>
    </div>
  </section>
</Base>

<style>
  /* ---------------- hero ---------------- */
  .hero { position: relative; }

  .hero__media {
    position: relative;
    aspect-ratio: 16 / 10;
    max-height: 62vh;
    overflow: hidden;
    background: var(--surface-sunk);
  }
  .hero__media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 58%;
  }
  .hero__media::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, #14142B 30%, transparent) 0%,
      color-mix(in srgb, #14142B 8%, transparent) 45%,
      var(--paper) 100%
    );
  }

  .hero__body {
    position: relative;
    margin-block-start: -14vh;
    padding-block-end: var(--s-7);
    text-align: center;
  }
  @media (min-width: 768px) { .hero__body { margin-block-start: -18vh; } }

  .hero__lineage {
    font-family: var(--serif);
    font-size: var(--t-sm);
    font-style: italic;
    color: var(--ink-soft);
    max-width: 34ch;
    margin-inline: auto;
    line-height: 1.5;
  }
  .hero__title {
    margin-block-start: var(--s-4);
    font-size: var(--t-3xl);
  }
  .hero__place {
    margin-block-start: var(--s-3);
    font-size: var(--t-sm);
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .hero__verse {
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-5);
    border-top: 1px solid var(--rule);
    max-width: 46ch;
    margin-inline: auto;
  }

  .hero__actions {
    margin-block-start: var(--s-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: center;
  }

  /* ---------------- ledger ---------------- */
  .ledger__head { max-width: 22ch; margin-block: var(--s-3) var(--s-6); }

  .ledger {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .ledger__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s-2) var(--s-5);
    align-items: baseline;
    padding-block: var(--s-5);
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--rule-soft);
    transition: background-color 0.16s var(--ease);
  }
  .ledger__row:last-child { border-bottom: none; }
  .ledger__row:hover { background: var(--surface-sunk); }

  .ledger__amt {
    font-family: var(--serif);
    font-size: var(--t-xl);
    font-weight: 600;
    color: var(--laterite);
    grid-column: 1;
  }
  .ledger__what { grid-column: 1 / -1; display: grid; gap: var(--s-1); }
  .ledger__what strong {
    font-family: var(--serif);
    font-size: var(--t-md);
    color: var(--ink);
    font-weight: 600;
  }
  .ledger__what span { font-size: var(--t-sm); color: var(--text-muted); }
  .ledger__go {
    grid-row: 1;
    grid-column: 2;
    color: var(--turmeric);
    font-size: var(--t-lg);
    transition: transform 0.16s var(--ease);
  }
  .ledger__row:hover .ledger__go { transform: translateX(4px); }

  @media (min-width: 700px) {
    .ledger__row { grid-template-columns: 190px 1fr auto; align-items: center; }
    .ledger__amt  { grid-column: 1; }
    .ledger__what { grid-column: 2; }
    .ledger__go   { grid-column: 3; }
  }

  .ledger__note {
    margin-block-start: var(--s-5);
    font-size: var(--t-sm);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  /* ---------------- ways ---------------- */
  .section--sunk {
    background: var(--surface-sunk);
    border-block: 1px solid var(--rule);
  }
  .ways__lede { margin-block: var(--s-4) var(--s-7); max-width: 52ch; }

  .ways__group + .ways__group { margin-block-start: var(--s-8); }
  .ways__ghead { margin-block-end: var(--s-5); }
  .ways__ghead h3 { font-size: var(--t-lg); }
  .ways__ghead p {
    margin-block-start: var(--s-2);
    font-size: var(--t-sm);
    color: var(--text-muted);
    max-width: 48ch;
  }
  .ways__grid {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
  }

  /* ---------------- verse ---------------- */
  .verse {
    padding-block: var(--s-9);
    background: var(--ink);
    color: var(--text-onDark);
    text-align: center;
  }
  .verse .shloka { color: var(--text-onDark); }
  .verse .shloka-gloss { color: color-mix(in srgb, var(--text-onDark) 65%, transparent); }

  /* ---------------- closing ---------------- */
  .closing { text-align: center; }
  .closing .lede { margin-block: var(--s-4) var(--s-6); margin-inline: auto; max-width: 46ch; }
</style>
