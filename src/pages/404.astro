---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn’t exist.">
  <section class="nf">
    <div class="wrap wrap--tight">
      <p class="eyebrow">404</p>
      <h1>That page isn’t here.</h1>
      <p class="lede">
        The site was rebuilt in 2026 and a few old links moved. Everything to do
        with giving now lives under Go Seva.
      </p>
      <div class="nf__actions">
        <a href="/goseva" class="btn btn--primary">Ways to give</a>
        <a href="/" class="btn btn--ghost">Home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: var(--s-9); text-align: center; }
  .nf .eyebrow { justify-content: center; }
  .nf h1 { margin-block: var(--s-4); }
  .nf .lede { margin-inline: auto; max-width: 44ch; }
  .nf__actions {
    margin-block-start: var(--s-6);
    display: flex;
    gap: var(--s-3);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
